# Application
APP_NAME=my-project
APP_ENV=development
APP_DEBUG=true

# Backend
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Frontend
FRONTEND_PORT=5173
# Origem do backend, sem o prefixo /api/v1 (as rotas do contrato já incluem o prefixo)
VITE_API_URL=http://localhost:8000

# Database
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Usado ao rodar o backend fora do Docker (make dev-backend).
# No docker-compose, o host é sobrescrito para "db".
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/app
