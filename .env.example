# Application
APP_NAME=yoda
APP_ENV=development
APP_DEBUG=true

# Backend
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Autenticação
# Chave de assinatura do token de sessão, com pelo menos 32 caracteres. Em APP_ENV=development,
# se omitida, usa uma chave fixa de desenvolvimento; nos demais ambientes é obrigatória.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_HOURS=168
# true quando a aplicação for servida por HTTPS.
AUTH_COOKIE_SECURE=false

# OpenAI (LLM Gateway)
# Sem chave, a aplicação sobe, mas o envio de mensagens responde com erro.
OPENAI_API_KEY=
# Modelo de desenvolvimento; o de produção ainda será definido.
OPENAI_MODEL=gpt-6-luna
# none, low, medium, high, xhigh ou max. Menos esforço = primeira palavra chega mais rápido.
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=60

# Contexto enviado ao modelo: quantas mensagens recentes da conversa entram.
CONTEXT_RECENT_MESSAGES=20

# Frontend
FRONTEND_PORT=5173
# Origem do backend, sem o prefixo /api/v1 (as rotas do contrato já incluem o prefixo)
VITE_API_URL=http://localhost:8000

# Database
POSTGRES_DB=yoda
POSTGRES_USER=yoda
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Usado ao rodar o backend fora do Docker (make dev-backend).
# No docker-compose, o host é sobrescrito para "db".
DATABASE_URL=postgresql+psycopg://yoda:change-me@localhost:5432/yoda

# Banco usado pelos testes do backend (criado automaticamente se não existir).
TEST_DATABASE_URL=postgresql+psycopg://yoda:change-me@localhost:5432/yoda_test
